{
  "name": "@viralganatra/octopus-tariff",
  "author": "Viral Ganatra <viral@viralganatra.com>",
  "license": "MIT",
  "version": "1.0.0",
  "description": "Smart Tariff Calculator",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "deploy:dev": "sst deploy --stage development",
    "deploy:prod": "sst deploy --stage production",
    "dev": "sst dev",
    "format": "biome format --write --no-errors-on-unmatched",
    "lint": "biome lint",
    "prepare": "husky",
    "sso": "aws sso login --sso-session=octopus",
    "test": "TZ=UTC vitest",
    "typecheck": "tsc -b",
    "generate:creds": "sh ./scripts/export-sso-creds.sh"
  },
  "type": "module",
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@date-fns/tz": "^1.5.0",
    "@pulumi/aws": "^7.50.0",
    "camelcase-keys": "^10.0.3",
    "date-fns": "^4.4.0",
    "sst": "^4.17.2",
    "type-fest": "^5.10.0",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "graphql": "^17.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*": "biome format --write --no-errors-on-unmatched"
  }
}
