{
  "name": "@viralganatra/octopus-tariff",
  "author": "Viral Ganatra <viral@viralganatra.com>",
  "license": "MIT",
  "version": "1.0.0",
  "description": "Smart Tariff Calculator",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "deploy:dev": "sst deploy --stage development",
    "deploy:prod": "sst deploy --stage production",
    "dev": "sst dev",
    "format": "biome format --write --no-errors-on-unmatched",
    "lint": "biome lint",
    "prepare": "husky",
    "sso": "aws sso login --sso-session=octopus",
    "test": "TZ=UTC vitest",
    "typecheck": "tsc -b",
    "generate:creds": "sh ./scripts/export-sso-creds.sh"
  },
  "type": "module",
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.33.1",
    "@aws-sdk/client-dynamodb": "^3.1064.0",
    "@aws-sdk/client-sqs": "^3.1063.0",
    "@aws-sdk/util-dynamodb": "^3.996.4",
    "@date-fns/tz": "^1.5.0",
    "@pulumi/aws": "^7.32.0",
    "camelcase-keys": "^10.0.2",
    "date-fns": "^4.4.0",
    "sst": "^4.15.2",
    "type-fest": "^5.7.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.13.1",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*": "biome format --write --no-errors-on-unmatched"
  }
}
